<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Company>Offload</Company>
    <Product>Offload</Product>
    <Copyright>© Offload</Copyright>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <!-- Локализация интерфейса (L.T / L.F / L.Plural) доступна во всех проектах без using. -->
  <ItemGroup>
    <Using Include="Offload.Core.Localization" />
  </ItemGroup>
</Project>
